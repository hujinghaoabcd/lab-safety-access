# Public address handled by Caddy.
# Use :80 for an IP-only HTTP deployment, or exam.example.edu for automatic HTTPS.
SITE_ADDRESS=:80

# Required production secrets. Never commit real values.
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=系统管理员

# At least 8 characters. Used only when creating/importing users without an
# explicitly supplied initial password.
DEFAULT_USER_PASSWORD=

# Optional comma-separated cross-origin clients. Same-origin deployments do
# not need this value.
CORS_ORIGINS=

LOG_LEVEL=info
