{
  "name": "lab-safety-access-backend",
  "version": "1.1.0",
  "description": "实验室安全教育与准入考试系统 - API服务",
  "main": "src/app.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "init-db": "node src/database/init.js",
    "db:status": "node src/database/cli.js status",
    "db:migrate": "node src/database/cli.js migrate",
    "db:backup": "node src/database/cli.js backup",
    "db:verify": "node src/database/cli.js verify",
    "db:restore": "node src/database/cli.js restore",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "minimatch@3.1.2": "3.1.4"
  }
}
